# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Allowed browser origin. In dev the client proxies /api through Vite, so requests are
# same-origin; this matters for direct/cross-origin calls and for production.
CORS_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file lives inside server/prisma/. Relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
# Separate secret used to hash refresh tokens at rest. Never reuse the access secret.
REFRESH_TOKEN_PEPPER=replace-me-with-another-long-random-string

# Access token lifetime (short — it lives in memory and is refreshed silently).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime (long — it is the httpOnly cookie).
REFRESH_TOKEN_TTL_SECONDS=2592000

# Set to true only when serving over HTTPS; Secure cookies are dropped over plain http.
COOKIE_SECURE=false
COOKIE_DOMAIN=
