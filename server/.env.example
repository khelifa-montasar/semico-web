# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Allowed browser origin. In dev the client proxies /api through Vite, so requests are
# same-origin; this matters for direct/cross-origin calls and for production.
CORS_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file lives inside server/prisma/. Relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
# Separate secret used to hash refresh tokens at rest. Never reuse the access secret.
REFRESH_TOKEN_PEPPER=replace-me-with-another-long-random-string

# Access token lifetime (short — it lives in memory and is refreshed silently).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime (long — it is the httpOnly cookie).
REFRESH_TOKEN_TTL_SECONDS=2592000

# Set to true only when serving over HTTPS; Secure cookies are dropped over plain http.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Platform admin seed (used only by npm run db:seed:admin) ───────────────────
SUPER_ADMIN_EMAIL=admin@semico.dz
SUPER_ADMIN_NAME="Platform Admin"
# Required by the admin seed: 8–200 characters. No default password is created.
# SUPER_ADMIN_PASSWORD=

# ── MQTT device telemetry and valve commands (disabled when MQTT_URL is unset) ─
# Production must use mqtts://. Server credentials need telemetry subscribe, command publish,
# and acknowledgment subscribe permissions. Device credentials should be limited to its own
# telemetry/ack publish topics and command subscribe topic.
# MQTT_URL=mqtts://broker.example.com:8883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=semico/v1/devices
# Server-controlled deviceId -> farm/zone mapping. Never put farmId in a device payload.
# Example: {"controller-01":{"farmId":"<farm-id>","zoneId":"<zone-id>","kind":"CONTROLLER"}}
MQTT_DEVICE_REGISTRY={}

# Optional local ESP32 simulator. Use its separate device-scoped broker credentials.
# SIMULATOR_MQTT_URL=mqtt://localhost:1883
# SIMULATOR_MQTT_USERNAME=
# SIMULATOR_MQTT_PASSWORD=
# SIMULATOR_MQTT_TOPIC_PREFIX=semico/v1/devices
# SIMULATOR_DEVICE_ID=controller-01
# SIMULATOR_TELEMETRY_INTERVAL_MS=5000
# SIMULATOR_ROOT_MOISTURE=17.5
